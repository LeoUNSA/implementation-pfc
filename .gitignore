# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# Raw dataset downloads (large, reproducible via `vulnpipe corpus build`)
data/

# Regenerable scan inputs and raw tool reports (large / throwaway):
#   findings/scan/  = one materialized .java per snippet
#   *.sarif         = raw SAST reports (parsed into the tracked jsonl below)
findings/scan/
*.sarif

# Figures are regenerated from the tracked findings.
figures/

# Docs stay local.
docs/

# TRACKED on purpose (expensive to regenerate — minutes of SAST/LLM runtime):
#   corpus/*.jsonl                  ground truth
#   findings/*_perSnippet.jsonl     per-detector verdicts (incl. LLM)
#   findings/llm_runs/*.jsonl       raw per-run LLM outputs
#   metrics/*.csv                   scored comparison tables
